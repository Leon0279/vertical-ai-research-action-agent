# Local runtime configuration template.
# Copy to .env for local development and replace placeholder values.

# Redis session memory
REDIS_SESSION_MEMORY_URL=redis://localhost:6379/0
REDIS_SESSION_MEMORY_KEY_PREFIX=session_memory
REDIS_SESSION_MEMORY_TTL_SECONDS=86400

# PostgreSQL memory stores
POSTGRES_PROJECT_PROFILE_MEMORY_DSN=postgresql://postgres:postgres@localhost:5432/vertical_ai_research_action_agent
POSTGRES_PROJECT_PROFILE_MEMORY_SCHEMA=public
POSTGRES_PROJECT_PROFILE_MEMORY_TABLE=project_profile_memory

POSTGRES_DECISION_MEMORY_DSN=postgresql://postgres:postgres@localhost:5432/vertical_ai_research_action_agent
POSTGRES_DECISION_MEMORY_SCHEMA=public
POSTGRES_DECISION_MEMORY_TABLE=decision_memory

POSTGRES_ACTION_MEMORY_DSN=postgresql://postgres:postgres@localhost:5432/vertical_ai_research_action_agent
POSTGRES_ACTION_MEMORY_SCHEMA=public
POSTGRES_ACTION_MEMORY_TABLE=action_memory

POSTGRES_PREFERENCE_POLICY_MEMORY_DSN=postgresql://postgres:postgres@localhost:5432/vertical_ai_research_action_agent
POSTGRES_PREFERENCE_POLICY_MEMORY_SCHEMA=public
POSTGRES_PREFERENCE_POLICY_MEMORY_TABLE=preference_policy_memory
POSTGRES_PREFERENCE_POLICY_MEMORY_SYSTEM_USER_ID=__system__

POSTGRES_RESEARCH_KNOWLEDGE_MEMORY_DSN=postgresql://postgres:postgres@localhost:5432/vertical_ai_research_action_agent
POSTGRES_RESEARCH_KNOWLEDGE_MEMORY_SCHEMA=public
POSTGRES_RESEARCH_KNOWLEDGE_MEMORY_TABLE=research_knowledge_units
POSTGRES_RESEARCH_KNOWLEDGE_MEMORY_MAX_RECALL_LIMIT=20

# Zhipu LLM and embeddings
ZHIPU_API_KEY=replace-with-your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.1
ZHIPU_TIMEOUT_SECONDS=30
ZHIPU_TEMPERATURE=1.0
ZHIPU_MAX_TOKENS=1024

ZHIPU_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_DIMENSIONS=1024
ZHIPU_EMBEDDING_TIMEOUT_SECONDS=30
ZHIPU_EMBEDDING_MAX_BATCH_SIZE=64

# Docs search
DOCS_SEARCH_SOURCES_JSON=[{"source_name":"openai_api","llms_txt_url":"https://platform.openai.com/docs/llms.txt","allowed_url_prefixes":["https://platform.openai.com/docs","https://developers.openai.com"]},{"source_name":"anthropic_api","llms_txt_url":"https://docs.anthropic.com/llms.txt","allowed_url_prefixes":["https://docs.anthropic.com"]},{"source_name":"claude_code","llms_txt_url":"https://code.claude.com/docs/llms.txt","allowed_url_prefixes":["https://code.claude.com/docs"]}]
DOCS_SEARCH_TIMEOUT_SECONDS=10
DOCS_SEARCH_DEFAULT_LIMIT=5
DOCS_SEARCH_MAX_LIMIT=20
DOCS_SEARCH_FETCH_TOP_PAGES=3
DOCS_SEARCH_MAX_PAGE_CHARS=60000

# Web search
TAVILY_API_KEY=replace-with-your-tavily-api-key
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_SECONDS=10
TAVILY_DEFAULT_LIMIT=5
TAVILY_MAX_LIMIT=20
TAVILY_TOPIC=general
TAVILY_INCLUDE_ANSWER=false
TAVILY_INCLUDE_RAW_CONTENT=false

# arXiv paper search
ARXIV_PAPER_SEARCH_USER_AGENT=vertical-ai-research-action-agent/0.1.0
ARXIV_PAPER_SEARCH_CLIENT_IDENTITY=contact:replace-with-your-email@example.com
ARXIV_PAPER_SEARCH_BASE_URL=https://export.arxiv.org/api
ARXIV_PAPER_SEARCH_TIMEOUT_SECONDS=10
ARXIV_PAPER_SEARCH_DEFAULT_LIMIT=5
ARXIV_PAPER_SEARCH_MAX_LIMIT=20
ARXIV_PAPER_SEARCH_MIN_INTERVAL_SECONDS=3

# arXiv paper PDF content fetch
ARXIV_PAPER_CONTENT_FETCH_USER_AGENT=vertical-ai-research-action-agent/0.1.0
ARXIV_PAPER_CONTENT_FETCH_CLIENT_IDENTITY=contact:replace-with-your-email@example.com
ARXIV_PAPER_CONTENT_FETCH_PDF_BASE_URL=https://arxiv.org/pdf
ARXIV_PAPER_CONTENT_FETCH_TIMEOUT_SECONDS=20
ARXIV_PAPER_CONTENT_FETCH_MAX_DOWNLOAD_BYTES=25000000
ARXIV_PAPER_CONTENT_FETCH_MAX_EXTRACTED_CHARS=200000
